MALWAREBAZAAR_AUTH_KEY=your-auth-key-from-https://auth.abuse.ch

# Optional: GitHub API token for higher rate limits on benign collection
GITHUB_TOKEN=

# Scheduler (daemon mode: python -m src.graph --daemon)
AMD_SCHED_ENABLED=0
AMD_SCHED_INTERVAL=1800
AMD_SCHED_MAX_RUNS=
AMD_SCHED_RUN_ON_START=1
AMD_SCHED_JITTER=60
AMD_SCHED_ERROR_BACKOFF=60
AMD_SCHED_MAX_BACKOFF=3600

# Force benign provider: sysinternals | github (empty = round-robin)
AMD_BENIGN_PROVIDER=

# Optional offline fallback: ingest data/benign/*.bin as label=0
AMD_ALLOW_LOCAL_BENIGN=0

# ThreatIngestor pending-hash queue (malware path checks SQLite before live API)
AMD_THREAT_QUEUE_ENABLED=1

# Ollama cognitive engine (container defaults to host.docker.internal via compose)
AMD_OLLAMA_ENABLED=1
AMD_OLLAMA_BASE_URL=http://localhost:11434
AMD_OLLAMA_MODEL=llama3.1:8b
AMD_OLLAMA_TIMEOUT=8

# capa explainability
AMD_CAPA_RULES_DIR=/opt/capa-rules
AMD_REPORT_LANGUAGE=English
