# Required: abuse.ch Auth-Key (MalwareBazaar + ThreatFox discovery fallback)
MALWAREBAZAAR_AUTH_KEY=your-auth-key-from-https://auth.abuse.ch

# Optional: GitHub API token for higher release API limits
GITHUB_TOKEN=

# Scheduler (used by: python -m src.graph --daemon)
AMD_SCHED_ENABLED=0
AMD_SCHED_INTERVAL=1800
AMD_SCHED_MAX_RUNS=
AMD_SCHED_RUN_ON_START=1
AMD_SCHED_JITTER=60
AMD_SCHED_ERROR_BACKOFF=60
AMD_SCHED_MAX_BACKOFF=3600

# First-run Docker bootstrap (amd-agent-run.sh skips when 100/100 + model.pkl ready)
AMD_BOOTSTRAP_MAX_RUNS=60
AMD_BOOTSTRAP_INTERVAL=10

# River ADWIN drift sensitivity (higher = less sensitive; production often 0.01–0.05)
AMD_ADWIN_DELTA=0.002

# MalwareBazaar circuit breaker (consecutive 5xx/transport failures)
AMD_MB_CIRCUIT_FAILURE_THRESHOLD=3
AMD_MB_CIRCUIT_OPEN_SECONDS=120

# CTI scrape host blocklist TTL after errors (seconds)
AMD_CTI_HOST_BLOCK_SECONDS_403=900
AMD_CTI_HOST_BLOCK_SECONDS_429=3600
AMD_CTI_HOST_BLOCK_SECONDS_TRANSPORT=300

# Source selection and local benign fallback
AMD_BENIGN_PROVIDER=
AMD_ALLOW_LOCAL_BENIGN=0
AMD_INTEL_INGEST_ENABLED=1
AMD_INTEL_MIN_POLL_INTERVAL=60
AMD_INTEL_MAX_POLL_INTERVAL=3600
AMD_INTEL_PENDING_CAP_MULT=3
AMD_OLLAMA_SOURCE_SELECTION=1
AMD_CTI_DOWNLOAD_ALLOWLIST=github.com,raw.githubusercontent.com,objects.githubusercontent.com
AMD_PE_DOWNLOAD_MAX_BYTES=250000

# InQuest ThreatIngestor sidecar (Plan B: artifact poll in amd-agent)
AMD_THREATINGESTOR_ENABLED=1
AMD_THREATINGESTOR_ARTIFACT_DB=/data/threatingestor_artifacts.db
AMD_THREATINGESTOR_BRIDGE_BATCH=100
AMD_THREATINGESTOR_SLEEP_BOOTSTRAP=60
AMD_THREATINGESTOR_SLEEP_STEADY=900

# Ollama cognitive engine
AMD_OLLAMA_ENABLED=1
AMD_OLLAMA_BASE_URL=http://localhost:11434
AMD_OLLAMA_MODEL=llama3.1:8b
AMD_OLLAMA_TIMEOUT=8

# Dynamic CTI discovery limits
AMD_CTI_SEARCH_LIMIT=5
AMD_CTI_PAGE_LIMIT=5
AMD_CTI_PAGE_MAX_BYTES=250000
AMD_CTI_REQUEST_TIMEOUT=20

# capa explainability
AMD_CAPA_RULES_DIR=/opt/capa-rules
AMD_REPORT_LANGUAGE=English
